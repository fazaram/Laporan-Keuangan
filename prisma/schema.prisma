generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String            @id @default(cuid())
  email                String            @unique
  password             String
  name                 String?
  role                 UserRole          @default(USER)
  resetToken           String?           @unique
  resetTokenExpiry     DateTime?
  bio                  String?
  birthDate            DateTime?         @db.Date
  profileImage         String?
  fixedIncome          Decimal?          @db.Decimal(20, 2)
  fixedIncomeStartDate DateTime?         @db.Date
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  auditLogs            AuditLog[]
  chatHistories        ChatHistory[]
  goalAllocations      GoalAllocation[]
  goals                Goal[]
  monthlyAnalyses      MonthlyAnalysis[]
  transactions         Transaction[]
  yearlyAnalyses       YearlyAnalysis[]
  wallets              Wallet[]
  walletRules          WalletRule[]
  walletTransactions   WalletTransaction[]
  status               UserStatus        @default(ACTIVE)
  broadcasts           Broadcast[]

  @@map("users")
}

model Transaction {
  id          String          @id @default(cuid())
  date        DateTime
  category    String
  amount      Decimal         @db.Decimal(20, 2)
  type        TransactionType
  description String?
  userId      String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId    String?
  wallet      Wallet?         @relation(fields: [walletId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([userId, type])
  @@map("transactions")
}

model MonthlyAnalysis {
  id                   String   @id @default(cuid())
  year                 Int
  month                Int
  totalIncome          Decimal  @db.Decimal(20, 2)
  totalExpense         Decimal  @db.Decimal(20, 2)
  balance              Decimal  @db.Decimal(20, 2)
  previousMonthIncome  Decimal? @db.Decimal(20, 2)
  previousMonthExpense Decimal? @db.Decimal(20, 2)
  previousMonthBalance Decimal? @db.Decimal(20, 2)
  analysis             String?
  recommendations      String?
  userId               String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
  @@index([userId])
  @@map("monthly_analyses")
}

model YearlyAnalysis {
  id                    String   @id @default(cuid())
  year                  Int
  totalIncome           Decimal  @db.Decimal(20, 2)
  totalExpense          Decimal  @db.Decimal(20, 2)
  balance               Decimal  @db.Decimal(20, 2)
  averageMonthlyIncome  Decimal  @db.Decimal(20, 2)
  averageMonthlyExpense Decimal  @db.Decimal(20, 2)
  previousYearIncome    Decimal? @db.Decimal(20, 2)
  previousYearExpense   Decimal? @db.Decimal(20, 2)
  previousYearBalance   Decimal? @db.Decimal(20, 2)
  analysis              String?
  recommendations       String?
  userId                String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
  @@index([userId])
  @@map("yearly_analyses")
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String
  action     AuditAction
  entityType String
  entityId   String
  oldData    Json?
  newData    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Goal {
  id             String           @id @default(cuid())
  userId         String
  name           String
  targetAmount   Decimal          @db.Decimal(20, 2)
  currentAmount  Decimal          @default(0) @db.Decimal(20, 2)
  durationMonths Int
  startDate      DateTime         @db.Date
  priority       GoalPriority     @default(MEDIUM)
  status         GoalStatus       @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  allocations    GoalAllocation[]
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("goals")
}

model GoalAllocation {
  id          String   @id @default(cuid())
  userId      String
  goalId      String
  amount      Decimal  @db.Decimal(20, 2)
  month       Int
  year        Int
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@index([userId])
  @@index([month, year])
  @@map("goal_allocations")
}

model ChatHistory {
  id        String   @id @default(cuid())
  userId    String
  role      String
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("chat_histories")
}

model Wallet {
  id           String        @id @default(cuid())
  userId       String
  name         String
  icon         String?
  color        String        @default("#3B82F6")
  balance      Decimal       @default(0) @db.Decimal(20, 2)
  budgetAmount Decimal       @default(0) @db.Decimal(20, 2)
  spentAmount  Decimal       @default(0) @db.Decimal(20, 2)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  rules        WalletRule[]
  transactions Transaction[]
  outgoingTransactions WalletTransaction[] @relation("FromWallet")
  incomingTransactions WalletTransaction[] @relation("ToWallet")

  @@index([userId])
  @@map("wallets")
}

model WalletRule {
  id          String   @id @default(cuid())
  userId      String
  walletId    String
  percentage  Decimal? @db.Decimal(5, 2) // e.g. 10.50 (for 10.5%)
  fixedAmount Decimal? @db.Decimal(20, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([walletId])
  @@map("wallet_rules")
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_config")
}

model WalletTransaction {
  id           String   @id @default(cuid())
  userId       String
  fromWalletId String?
  toWalletId   String?
  amount       Decimal  @db.Decimal(20, 2)
  type         String   // TRANSFER, TOPUP, WITHDRAW
  description  String?
  createdAt    DateTime @default(now())
  fromWallet   Wallet?  @relation("FromWallet", fields: [fromWalletId], references: [id], onDelete: SetNull)
  toWallet     Wallet?  @relation("ToWallet", fields: [toWalletId], references: [id], onDelete: SetNull)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("wallet_transactions")
}

model Broadcast {
  id        String   @id @default(cuid())
  title     String
  message   String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())

  @@map("broadcasts")
}

enum UserRole {
  VIEWER
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum GoalPriority {
  LOW
  MEDIUM
  HIGH
}

enum GoalStatus {
  ACTIVE
  COMPLETED
}
