generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String            @id @default(cuid())
  email                String            @unique
  password             String
  name                 String?
  role                 UserRole          @default(USER)
  resetToken           String?           @unique
  resetTokenExpiry     DateTime?
  bio                  String?
  birthDate            DateTime?         @db.Date
  profileImage         String?
  fixedIncome          Decimal?          @db.Decimal(15, 2)
  fixedIncomeStartDate DateTime?         @db.Date
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  auditLogs            AuditLog[]
  chatHistories        ChatHistory[]
  goalAllocations      GoalAllocation[]
  goals                Goal[]
  monthlyAnalyses      MonthlyAnalysis[]
  transactions         Transaction[]
  yearlyAnalyses       YearlyAnalysis[]

  @@map("users")
}

model Transaction {
  id          String          @id @default(cuid())
  date        DateTime
  category    String
  amount      Decimal         @db.Decimal(15, 2)
  type        TransactionType
  description String?
  userId      String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, type])
  @@map("transactions")
}

model MonthlyAnalysis {
  id                   String   @id @default(cuid())
  year                 Int
  month                Int
  totalIncome          Decimal  @db.Decimal(15, 2)
  totalExpense         Decimal  @db.Decimal(15, 2)
  balance              Decimal  @db.Decimal(15, 2)
  previousMonthIncome  Decimal? @db.Decimal(15, 2)
  previousMonthExpense Decimal? @db.Decimal(15, 2)
  previousMonthBalance Decimal? @db.Decimal(15, 2)
  analysis             String?
  recommendations      String?
  userId               String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
  @@index([userId])
  @@map("monthly_analyses")
}

model YearlyAnalysis {
  id                    String   @id @default(cuid())
  year                  Int
  totalIncome           Decimal  @db.Decimal(15, 2)
  totalExpense          Decimal  @db.Decimal(15, 2)
  balance               Decimal  @db.Decimal(15, 2)
  averageMonthlyIncome  Decimal  @db.Decimal(15, 2)
  averageMonthlyExpense Decimal  @db.Decimal(15, 2)
  previousYearIncome    Decimal? @db.Decimal(15, 2)
  previousYearExpense   Decimal? @db.Decimal(15, 2)
  previousYearBalance   Decimal? @db.Decimal(15, 2)
  analysis              String?
  recommendations       String?
  userId                String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
  @@index([userId])
  @@map("yearly_analyses")
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String
  action     AuditAction
  entityType String
  entityId   String
  oldData    Json?
  newData    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Goal {
  id             String           @id @default(cuid())
  userId         String
  name           String
  targetAmount   Decimal          @db.Decimal(15, 2)
  currentAmount  Decimal          @default(0) @db.Decimal(15, 2)
  durationMonths Int
  startDate      DateTime         @db.Date
  priority       GoalPriority     @default(MEDIUM)
  status         GoalStatus       @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  allocations    GoalAllocation[]
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("goals")
}

model GoalAllocation {
  id          String   @id @default(cuid())
  userId      String
  goalId      String
  amount      Decimal  @db.Decimal(15, 2)
  month       Int
  year        Int
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@index([userId])
  @@index([month, year])
  @@map("goal_allocations")
}

model ChatHistory {
  id        String   @id @default(cuid())
  userId    String
  role      String
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("chat_histories")
}

enum UserRole {
  VIEWER
  USER
  ADMIN
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum GoalPriority {
  LOW
  MEDIUM
  HIGH
}

enum GoalStatus {
  ACTIVE
  COMPLETED
}
